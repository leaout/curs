# Curs Trading V2 backend
TRADING_V2_HOST=127.0.0.1
TRADING_V2_PORT=8010
TRADING_V2_ENVIRONMENT=development
TRADING_V2_TRADING_MODE=observe
TRADING_V2_CPPTDX_BASE_URL=http://127.0.0.1:8022
TRADING_V2_CPPTDX_TIMEOUT_SECONDS=3
TRADING_V2_DATABASE_URL=sqlite:///data/trading_v2.db

# Model providers: deepseek | openai | anthropic | openai_compatible
# API keys are read indirectly from the named environment variable.
TRADING_V2_MODEL_ENABLED=false
TRADING_V2_MODEL_PROVIDER=deepseek
TRADING_V2_MODEL_NAME=deepseek-chat
TRADING_V2_MODEL_API_KEY_ENV=DEEPSEEK_API_KEY
TRADING_V2_MODEL_BASE_URL=
TRADING_V2_MODEL_TIMEOUT_SECONDS=20
TRADING_V2_MODEL_MAX_TOKENS=1500
TRADING_V2_SIGNAL_POLL_INTERVAL_SECONDS=5
TRADING_V2_SIGNAL_BAR_LIMIT=200

# Use a JSON array when the Vite UI is not served through its development proxy.
TRADING_V2_CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
